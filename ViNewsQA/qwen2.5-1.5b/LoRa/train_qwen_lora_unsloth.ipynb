        "    p.add_argument(\"--max-new-tokens\", type=int, default=64); p.add_argument(\"--batch-size\", type=int, default=16); p.add_argument(\"--log-every\", type=int, default=50)\n",
        "    return p.parse_args()\n",
        "def main():\n",
        "    a = args()\n",
