    "def is_valid_adapter_dir(adapter_dir, min_bytes=50_000):\n",
    "    \"\"\"True nếu adapter_model.safetensors/.bin tồn tại, đủ lớn, và safetensors đọc được.\"\"\"\n",
    "    adapter_dir = Path(adapter_dir)\n",
    "    weight = None\n",
    "    for name in (\"adapter_model.safetensors\", \"adapter_model.bin\"):\n",
    "        candidate = adapter_dir / name\n",
    "        if candidate.is_file():\n",
    "            weight = candidate\n",
    "            break\n",
    "    if weight is None:\n",
    "        return False\n",
    "    size = weight.stat().st_size\n",
    "    if size < min_bytes:\n",
    "        print(f\"[eval] Invalid {weight}: {size} B (too small)\", flush=True)\n",
    "        return False\n",
    "    if weight.suffix == \".safetensors\":\n",
    "        try:\n",
    "            from safetensors import safe_open\n",
    "            with safe_open(str(weight), framework=\"pt\") as handle:\n",
    "                _ = list(handle.keys())\n",
    "        except Exception as exc:\n",
    "            print(f\"[eval] Corrupt safetensors {weight}: {exc}\", flush=True)\n",
    "            return False\n",
    "    if not (adapter_dir / \"adapter_config.json\").is_file():\n",
    "        print(f\"[eval] Missing adapter_config.json in {adapter_dir}\", flush=True)\n",
    "        return False\n",
    "    print(f\"[eval] OK {adapter_dir} | {weight.name}={size / 1e6:.2f} MB\", flush=True)\n",
    "    return True\n",
    "\n",
    "\n",
    "def resolve_eval_adapter_path(method_name, save_path=None, output_dir=None):\n",
    "    \"\"\"Ưu tiên save_path hợp lệ; nếu corrupt thì lấy checkpoint-* mới nhất còn đọc được.\"\"\"\n",
    "    variant = next((v for v in ADAPTER_VARIANTS if v[\"name\"] == method_name), None)\n",
    "    save_path = Path(save_path or (variant[\"save_path\"] if variant else method_name))\n",
    "    output_dir = Path(output_dir or (variant[\"output_dir\"] if variant else f\"outputs_vinewsqa_{method_name}\"))\n",
    "\n",
    "    if is_valid_adapter_dir(save_path):\n",
    "        return str(save_path)\n",
    "\n",
    "    ckpts = sorted(output_dir.glob(\"checkpoint-*\"), key=lambda p: int(p.name.split(\"-\")[-1]), reverse=True)\n",
    "    for ckpt in ckpts:\n",
    "        if is_valid_adapter_dir(ckpt):\n",
    "            print(f\"[eval] {method_name}: save_path corrupt/missing → using {ckpt}\", flush=True)\n",
    "            return str(ckpt)\n",
    "\n",
    "    raise FileNotFoundError(\n",
    "        f\"No valid adapter for {method_name}. Checked {save_path} and {output_dir}/checkpoint-*. \"\n",
    "        f\"Re-copy from a good checkpoint or retrain.\"\n",
    "    )\n",
    "\n",
    "\n",
    "def repair_save_path_from_checkpoint(method_name):\n",
    "    \"\"\"Copy adapter hợp lệ từ checkpoint vào save_path (sửa file 133B / header corrupt).\"\"\"\n",
    "    import shutil\n",
    "\n",
    "    variant = next(v for v in ADAPTER_VARIANTS if v[\"name\"] == method_name)\n",
    "    good = resolve_eval_adapter_path(method_name)\n",
    "    save_path = Path(variant[\"save_path\"])\n",
    "    if Path(good).resolve() == save_path.resolve() and is_valid_adapter_dir(save_path):\n",
    "        print(f\"[repair] {method_name}: save_path already OK\")\n",
    "        return str(save_path)\n",
    "    save_path.mkdir(parents=True, exist_ok=True)\n",
    "    for name in (\"adapter_model.safetensors\", \"adapter_model.bin\", \"adapter_config.json\",\n",
    "                 \"tokenizer.json\", \"tokenizer_config.json\", \"special_tokens_map.json\", \"chat_template.jinja\"):\n",
    "        src = Path(good) / name\n",
    "        if src.is_file():\n",
    "            shutil.copy2(src, save_path / name)\n",
    "            print(f\"[repair] copied {name} from {good}\")\n",
    "    if not is_valid_adapter_dir(save_path):\n",
    "        raise RuntimeError(f\"[repair] Failed to repair {save_path}\")\n",
    "    print(f\"[repair] {method_name} OK -> {save_path}\")\n",
    "    return str(save_path)\n",
    "\n",
    "\n",
    "def infer_predictions_subprocess(method_name, adapter_path, samples, max_seq_length, log_every):\n",
    "    import shutil\n",
    "    import subprocess\n",
    "    import sys\n",
    "    import tempfile\n",
    "\n",
    "    adapter_path = Path(adapter_path)\n",
    "    if not adapter_path.exists():\n",
    "        print(f\"SKIP {method_name}: missing {adapter_path}\")\n",
    "        return None\n",
    "    if not is_valid_adapter_dir(adapter_path):\n",
    "        raise FileNotFoundError(\n",
    "            f\"Invalid/corrupt adapter at {adapter_path}. \"\n",
    "            f\"Run repair_save_path_from_checkpoint('{method_name}') or point to a good checkpoint.\"\n",
    "        )\n",
    "\n",
    "    script = ensure_eval_infer_script()\n",
    "    temp_dir = Path(tempfile.mkdtemp(prefix=\"vinewsqa_eval_\"))\n",
    "    samples_path = temp_dir / \"samples.json\"\n",
    "    output_path = temp_dir / \"predictions.json\"\n",
    "    with open(samples_path, \"w\", encoding=\"utf-8\") as handle:\n",
    "        json.dump(samples, handle, ensure_ascii=False)\n",
    "    command = [\n",
    "        sys.executable, str(script),\n",
    "        \"--adapter-dir\", str(adapter_path),\n",
    "        \"--samples-json\", str(samples_path),\n",
    "        \"--output\", str(output_path),\n",
    "        \"--base-model\", BASE_MODEL_NAME,\n",
    "        \"--max-seq-length\", str(max_seq_length),\n",
    "        \"--max-new-tokens\", str(MAX_NEW_TOKENS),\n",
    "        \"--batch-size\", str(INFER_BATCH_SIZE),\n",
    "        \"--log-every\", str(log_every),\n",
    "    ]\n",
    "    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)\n",
    "    for line in process.stdout:\n",
    "        print(line.rstrip(), flush=True)\n",
    "    return_code = process.wait()\n",
    "    if return_code:\n",
    "        shutil.rmtree(temp_dir, ignore_errors=True)\n",
    "        raise RuntimeError(f\"{method_name} inference failed with exit code {return_code}.\")\n",
    "    with open(output_path, encoding=\"utf-8\") as handle:\n",
    "        predictions = json.load(handle)\n",
    "    shutil.rmtree(temp_dir, ignore_errors=True)\n",
    "    return predictions\n",
    "\n",
    "\n",
    "def eval_cache_path(method_name):\n",
    "    return EVAL_CACHE_DIR / f\"{method_name}_{EVAL_SPLIT}.json\"\n",
    "\n",
    "\n",
    "def load_cached_eval_result(method_name):\n",
    "    cache_path = eval_cache_path(method_name)\n",
    "    if cache_path.exists():\n",
    "        with open(cache_path, encoding=\"utf-8\") as handle:\n",
    "            return json.load(handle)\n",
    "    compare_path = Path(COMPARE_EVAL_PATH)\n",
    "    if compare_path.exists():\n",
    "        with open(compare_path, encoding=\"utf-8\") as handle:\n",
    "            comparison = json.load(handle)\n",
    "        summary = comparison.get(\"summary\", {})\n",
    "        predictions = comparison.get(\"predictions\", {})\n",
    "        if method_name in summary and method_name in predictions:\n",
    "            return {\"metrics\": summary[method_name], \"predictions\": predictions[method_name]}\n",
    "    return None\n",
    "\n",
    "\n",
    "def save_eval_cache(method_name, result):\n",
    "    EVAL_CACHE_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    with open(eval_cache_path(method_name), \"w\", encoding=\"utf-8\") as handle:\n",
    "        json.dump(result, handle, ensure_ascii=False)\n",
    "\n",
    "\n",
    "def seed_eval_cache_from_results(existing_results):\n",
    "    \"\"\"Gọi một lần nếu kernel còn all_results từ lần eval trước (lora/delora đã infer).\"\"\"\n",
    "    for method_name, result in existing_results.items():\n",
    "        save_eval_cache(method_name, result)\n",
    "        print(f\"[cache] Seeded {method_name} ({result['metrics']['n_samples']} samples)\")\n",
    "\n",
    "\n",
    "def eval_one_adapter(method_name, adapter_path, samples, max_seq_length):\n",
    "    selected = samples[:EVAL_MAX_SAMPLES] if EVAL_MAX_SAMPLES else samples\n",
    "    predictions = infer_predictions_subprocess(\n",
    "        method_name, adapter_path, selected, max_seq_length, EVAL_LOG_EVERY\n",
    "    )\n",
    "    if predictions is None:\n",
    "        return None\n",
    "    em_values, f1_values = [], []\n",
    "    for row in predictions:\n",
    "        em, f1 = score_prediction(row[\"prediction\"], row[\"gold_answers\"])\n",
    "        row[\"em\"], row[\"f1\"] = em, f1\n",
    "        em_values.append(em)\n",
    "        f1_values.append(f1)\n",
    "    metrics = {\n",
    "        \"method\": method_name,\n",
    "        \"adapter\": str(adapter_path),\n",
    "        \"exact_match\": round(100 * sum(em_values) / len(em_values), 4),\n",
    "        \"f1\": round(100 * sum(f1_values) / len(f1_values), 4),\n",
    "        \"n_samples\": len(predictions),\n",
    "    }\n",
    "    result = {\"metrics\": metrics, \"predictions\": predictions}\n",
    "    save_eval_cache(method_name, result)\n",
    "    return result\n",
    "\n",
    "\n",
    "def export_submission_one_adapter(method_name, adapter_path, samples, max_seq_length):\n",
    "    selected = samples[:SUBMISSION_MAX_SAMPLES] if SUBMISSION_MAX_SAMPLES else samples\n",
    "    predictions = infer_predictions_subprocess(\n",
    "        method_name, adapter_path, selected, max_seq_length, SUBMISSION_LOG_EVERY\n",
    "    )\n",
    "    if predictions is None:\n",
    "        return None\n",
    "    output_dir = Path(adapter_path)\n",
    "    output_dir.mkdir(parents=True, exist_ok=True)\n",
    "    output_path = output_dir / \"results.json\"\n",
    "    with open(output_path, \"w\", encoding=\"utf-8\") as handle:\n",
    "        json.dump({row[\"id\"]: row[\"prediction\"] for row in predictions}, handle, ensure_ascii=False, indent=2)\n",
    "    print(f\"Saved {output_path} ({len(predictions)} predictions)\")\n",
    "    return output_path\n"
